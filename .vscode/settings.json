{
  "editor.formatOnSave": false,
  "files.readonlyInclude": {
    "repos/**": true
  },
  "files.exclude": {
    "**/dist": true
  },
  "search.exclude": {
    "repos/**": true,
    "**/dist/**": true,
    "bun.lock": true,
    "bun.nix": true
  },
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "eslint.enable": false,
  "oxc.enable": true,
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  }
}
