{
  "$schema": "https://raw.githubusercontent.com/fallow-rs/fallow/main/schema.json",
  "entry": [
    "apps/games/public/index.html",
    "apps/beltworks/alchemy.run.ts",
    "apps/beltworks/web/index.html",
    "apps/beltworks/web/src/worker.ts",
    "apps/subq/alchemy.run.ts",
    "apps/subq/web/index.html",
    "apps/subq/web/src/worker.ts",
    "apps/logbook/alchemy.run.ts",
    "apps/logbook/web/index.html",
    "apps/logbook/web/src/worker.ts",
    "apps/battleblocks/alchemy.run.ts",
    "apps/battleblocks/web/index.html",
    "apps/battleblocks/web/src/worker.ts"
  ],
  "dynamicallyLoaded": ["tools/oxlint/anti-slop/effect/index.ts"],
  "rules": {
    "boundary-violation": "error",
    "policy-violation": "error"
  },
  "ignoreDependencies": ["@enfect/oxlint", "@oxlint/plugins", "oxlint-plugin-effect"],
  "ignoreExports": [
    {
      "file": "**/*.config.{js,mjs,ts}",
      "exports": ["default"]
    },
    {
      "file": "apps/beltworks/alchemy.run.ts",
      "exports": ["default"]
    },
    {
      "file": "apps/subq/alchemy.run.ts",
      "exports": ["default"]
    },
    {
      "file": "apps/logbook/alchemy.run.ts",
      "exports": ["default"]
    },
    {
      "file": "apps/battleblocks/alchemy.run.ts",
      "exports": ["default"]
    },
    {
      "file": "tools/oxlint/anti-slop/effect/index.ts",
      "exports": ["default"]
    }
  ]
}
