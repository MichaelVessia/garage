  "components": [
    {
      "name": "Rail Item",
      "kind": "nav",
      "refersTo": "rail-item-active",
      "description": "88 px labelled icon item in the 104 px rail; the active screen fills indigo.",
      "html": "<nav class=\"ds-rail\"><button class=\"ds-rail-item is-active\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8\"/><path d=\"M3 10a2 2 0 0 1 .709-1.528l7-6a2 2 0 0 1 2.582 0l7 6A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/></svg><span>Today</span></button><button class=\"ds-rail-item\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M8 2v3\"/><path d=\"M16 2v3\"/><rect x=\"3\" y=\"3\" width=\"18\" height=\"18\" rx=\"2\"/><path d=\"M3 9h18\"/></svg><span>Calendar</span></button></nav>",
      "css": ":root{--ground:#f3f4f6;--card:#ffffff;--ink:#14171c;--ink-2:#5b6270;--line:#e4e7ec;--sunken:#eef0f3;--accent:#4f5bd5;--accent-ink:#3b46b8;--accent-tint:#eceefd;--on-accent:#ffffff;--good:#1f8a4c;--good-tint:#e2f3e9;--elevation:0 1px 2px rgba(16,24,40,0.06),0 6px 16px rgba(16,24,40,0.06);--edge:0 0 0 1px transparent;--sans:'Figtree Variable','Roboto',system-ui,sans-serif;--r:16px;--r-sm:12px}.ds-rail{display:flex;flex-direction:column;align-items:center;gap:8px;width:104px;padding:24px 0;background:var(--card);box-shadow:1px 0 0 var(--line);font-family:var(--sans)}.ds-rail-item{width:88px;height:88px;border:0;border-radius:var(--r);display:flex;flex-direction:column;align-items:center;justify-content:center;gap:6px;background:none;color:var(--ink-2);font:600 16px var(--sans);cursor:pointer}.ds-rail-item svg{width:28px;height:28px}.ds-rail-item:active{background:var(--sunken)}.ds-rail-item:focus-visible{outline:3px solid var(--accent);outline-offset:2px}.ds-rail-item.is-active{background:var(--accent);color:var(--on-accent)}"
    },
    {
      "name": "Button",
      "kind": "button",
      "refersTo": "button",
      "description": "56 px Sunken Grey pill; pressed state on :active.",
      "html": "<button class=\"ds-btn\">Today</button>",
      "css": ":root{--ground:#f3f4f6;--card:#ffffff;--ink:#14171c;--ink-2:#5b6270;--line:#e4e7ec;--sunken:#eef0f3;--accent:#4f5bd5;--accent-ink:#3b46b8;--accent-tint:#eceefd;--on-accent:#ffffff;--good:#1f8a4c;--good-tint:#e2f3e9;--elevation:0 1px 2px rgba(16,24,40,0.06),0 6px 16px rgba(16,24,40,0.06);--edge:0 0 0 1px transparent;--sans:'Figtree Variable','Roboto',system-ui,sans-serif;--r:16px;--r-sm:12px}.ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:56px;padding:0 22px;border:0;border-radius:28px;background:var(--sunken);color:var(--ink);font:600 22px var(--sans);cursor:pointer}.ds-btn:active{background:var(--line)}.ds-btn:focus-visible{outline:3px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Ink-filled pill for the one committing action, such as Add.",
      "html": "<button class=\"ds-btn-primary\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"/><path d=\"M12 5v14\"/></svg>Add</button>",
      "css": ":root{--ground:#f3f4f6;--card:#ffffff;--ink:#14171c;--ink-2:#5b6270;--line:#e4e7ec;--sunken:#eef0f3;--accent:#4f5bd5;--accent-ink:#3b46b8;--accent-tint:#eceefd;--on-accent:#ffffff;--good:#1f8a4c;--good-tint:#e2f3e9;--elevation:0 1px 2px rgba(16,24,40,0.06),0 6px 16px rgba(16,24,40,0.06);--edge:0 0 0 1px transparent;--sans:'Figtree Variable','Roboto',system-ui,sans-serif;--r:16px;--r-sm:12px}.ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;height:56px;padding:0 22px;border:0;border-radius:28px;background:var(--ink);color:var(--card);font:600 22px var(--sans);cursor:pointer}.ds-btn-primary svg{width:24px;height:24px}.ds-btn-primary:active{background:var(--ink-2)}.ds-btn-primary:focus-visible{outline:3px solid var(--accent);outline-offset:2px}"
    },
    {
      "name": "Round Icon Button",
      "kind": "button",
      "refersTo": "icon-button",
      "description": "56 px circular control; green wash when the device is on.",
      "html": "<div class=\"ds-row\"><button class=\"ds-icon-btn\" aria-label=\"Play\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"/></svg></button><button class=\"ds-icon-btn is-on\" aria-label=\"Power\"><svg viewBox=\"0 0 24 24\" width=\"24\" height=\"24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z\"/></svg></button></div>",
      "css": ":root{--ground:#f3f4f6;--card:#ffffff;--ink:#14171c;--ink-2:#5b6270;--line:#e4e7ec;--sunken:#eef0f3;--accent:#4f5bd5;--accent-ink:#3b46b8;--accent-tint:#eceefd;--on-accent:#ffffff;--good:#1f8a4c;--good-tint:#e2f3e9;--elevation:0 1px 2px rgba(16,24,40,0.06),0 6px 16px rgba(16,24,40,0.06);--edge:0 0 0 1px transparent;--sans:'Figtree Variable','Roboto',system-ui,sans-serif;--r:16px;--r-sm:12px}.ds-row{display:flex;gap:8px}.ds-icon-btn{display:inline-flex;align-items:center;justify-content:center;width:56px;height:56px;border:0;border-radius:50%;background:var(--sunken);color:var(--ink);cursor:pointer}.ds-icon-btn svg{width:28px;height:28px}.ds-icon-btn:active{background:var(--line)}.ds-icon-btn:focus-visible{outline:3px solid var(--accent);outline-offset:2px}.ds-icon-btn.is-on{background:var(--good-tint);color:var(--good)}"
    },
