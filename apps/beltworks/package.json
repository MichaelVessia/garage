{
  "name": "@garage/beltworks",
  "private": true,
  "type": "module",
  "dependencies": {
    "@garage/beltworks-server": "workspace:*",
    "@alchemy.run/cloudflare": "2.0.0-beta.87",
    "alchemy": "2.0.0-beta.87",
    "effect": "4.1.5"
  },
  "scripts": {
    "dev": "alchemy dev",
    "plan": "alchemy plan",
    "deploy": "alchemy deploy",
    "deploy:prod": "alchemy deploy --stage prod --yes",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "format": "oxfmt --config ../../oxfmt.config.mjs --check alchemy.run.ts package.json tsconfig.json",
    "format:fix": "oxfmt --config ../../oxfmt.config.mjs alchemy.run.ts package.json tsconfig.json"
  }
}
