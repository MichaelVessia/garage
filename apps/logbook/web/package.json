{
  "name": "@garage/logbook-web",
  "private": true,
  "type": "module",
  "sideEffects": false,
  "dependencies": {
    "@garage/logbook-domain": "workspace:*",
    "@alchemy.run/domain": "2.0.0-beta.87",
    "@effect/platform-browser": "4.1.5",
    "effect": "4.1.5",
    "foldkit": "^0.170.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260829.1",
    "@effect/vitest": "4.1.5",
    "@tailwindcss/vite": "^4.3.3",
    "happy-dom": "^20.12.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "5.1.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "vite",
    "typecheck": "effect-tsgo tsrs --noEmit",
    "format": "oxfmt --config ../../../oxfmt.config.mjs --check src/ test/ index.html package.json tsconfig.json vite.config.ts vitest.config.ts",
    "format:fix": "oxfmt --config ../../../oxfmt.config.mjs src/ test/ index.html package.json tsconfig.json vite.config.ts vitest.config.ts",
    "test": "bun --bun vitest run"
  }
}
